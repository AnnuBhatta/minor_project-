# ────────────────────────────────────────────────────────────
# VitalWatch deployment configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` — it is git-ignored.
# ────────────────────────────────────────────────────────────

# Required — generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Set to your public URL, e.g. https://yourdomain.com
FRONTEND_URL=http://localhost
ALLOWED_HOSTS=*

# PostgreSQL (used by the docker-compose `db` service)
POSTGRES_DB=healthmonitor
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me-strong-password

# HTTP port the frontend listens on (leave 80 for a reverse proxy/TLS)
HTTP_PORT=80

# Email (SMTP) for alert emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@healthmonitor.com

# ─── Firebase / FCM ─────────────────────────────────────────
# Backend (Firebase Admin SDK) — EITHER set these env vars OR place
# firebase-adminsdk.json in ./backend and set FIREBASE_CREDENTIALS_PATH.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# Frontend (Web App config + VAPID key from Firebase console
# Project settings → Cloud Messaging). Passed as Docker build args.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=